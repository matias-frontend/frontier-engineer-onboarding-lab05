# Copy to .env and fill in. Never commit the real .env.

# Pinecone — free Starter plan at https://app.pinecone.io
PINECONE_API_KEY=

# Gemini — free tier at https://aistudio.google.com
GOOGLE_API_KEY=

# --- optional ---

# Chat model. NOT gemini-2.0-flash (shut down) or gemini-2.5-flash (closed to new keys).
# GEMINI_MODEL=gemini-3.6-flash

# Own namespace inside the shared free-tier index (Lab 04 uses others).
# PINECONE_NAMESPACE=lab05

# Rate limits
# RATE_LIMIT_RPM=20
# RATE_LIMIT_RPH=200
# RATE_LIMIT_TPM=100000

# Semantic cache threshold. Default 0.92 was measured with `npm run tune:cache`,
# not guessed: 0.95 caught only 1 of 6 paraphrase pairs. Raise toward 0.95 if a
# wrong cached answer would be costly in your domain — the populations overlap,
# so no value is perfectly safe.
# CACHE_SIMILARITY_THRESHOLD=0.92
# CACHE_MAX_ENTRIES=1000

# Self-RAG retrieval gating (off by default — it adds an LLM call)
# SELF_RAG=true

# Cost estimation. Defaults are placeholders; set your tier's real prices
# before treating /metrics cost figures as spend.
# GEMINI_INPUT_PRICE=0.075
# GEMINI_OUTPUT_PRICE=0.30

# Evaluation thresholds for the scheduled run
# EVAL_MIN_FAITHFULNESS=0.7
# EVAL_REGRESSION_TOLERANCE=0.1
